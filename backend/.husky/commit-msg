#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run from backend so local @commitlint/cli + .commitlintrc.js resolve
ROOT="$(cd "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT/backend" || exit 1

if [ ! -x "./node_modules/.bin/commitlint" ] && [ ! -f "./node_modules/.bin/commitlint.cmd" ]; then
  echo "commitlint not found in backend/node_modules — run: cd backend && npm install"
  exit 1
fi

./node_modules/.bin/commitlint --edit "$1"
